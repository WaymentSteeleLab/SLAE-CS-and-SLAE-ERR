Bootstrap: docker
From: pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

%labels
    Author Cizhang Zhao
    Description "MACE-OFF descriptor extraction"

%post
    pip install --no-cache-dir mace-torch==0.3.16 ase==3.29.0 biopython scipy
    # Bake the MACE-OFF23 large weights (Academic Software License) into the image; do not share the built image
    # (same URL mace_off(model="large") uses; python instead of wget, no apt needed)
    mkdir -p /opt/mace
    python -c "import urllib.request; urllib.request.urlretrieve('https://raw.githubusercontent.com/ACEsuit/mace-off/91a78c5a9c300d1104700d9352c8bfe449227737/mace_off23/MACE-OFF23_large.model', '/opt/mace/MACE-OFF23_large.model')"
    echo "a29e397dbf3e7a24ac50a9b0dfc919bd5a62efa346f5895a6237b0950c1d76f4  /opt/mace/MACE-OFF23_large.model" | sha256sum -c -
    chmod -R a+r /opt/mace

%environment
    export MACE_MODEL=/opt/mace/MACE-OFF23_large.model
